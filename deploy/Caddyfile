# Только локальный HTTP-стенд. Публичный домен и TLS настраиваются отдельным этапом.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		defer
	}
	@site not path /client/*
	header @site {
		Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options DENY
		defer
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# Клиент не может назначить себе другой адрес для лимита попыток.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Исходный клиент — демонстрация, встраиваемая только этим же сайтом.
	handle /client/* {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'"
			X-Frame-Options SAMEORIGIN
			Cache-Control no-cache
			defer
		}
		root * /srv
		file_server
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
