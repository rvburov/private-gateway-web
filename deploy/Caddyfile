# Caddy сайта: статика, /api/* на FastAPI, заголовки безопасности. Слушает только HTTP :8080.
# Локально (deploy/compose.yml) это сам стенд на 127.0.0.1:8080. На сервере TLS и домен
# держит общий вход — Caddy AI Agent Capper (deploy/compose.prod.yml, deploy/README.md):
# он передает запросы сюда по сети caddy-ingress и ставит X-Forwarded-For с IP посетителя.
{
	admin off
	auto_https off
	servers {
		# IP посетителя берется из X-Forwarded-For только от адресов общего входа
		# (PGWEB_TRUSTED_PROXIES, на сервере — подсеть caddy-ingress). Локально прокси нет:
		# доверие только loopback контейнера, подмена заголовка не меняет адрес для лимитов
		trusted_proxies static {$PGWEB_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	# Файлы клиента (/api/downloads/* и файлы ленты обновлений /api/app/updates/files/*) не
	# сжимаются: телефон и служба получают файл байт в байт, с Content-Length и типом от API.
	# Сжатие ничего не дает упакованным установщикам
	@compressible not path /api/downloads/* /api/app/updates/files/*
	encode @compressible zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		defer
	}
	@site not path /client/*
	header @site {
		Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options DENY
		defer
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			# Клиент не может назначить себе другой адрес для лимита попыток: {client_ip} —
			# адрес соединения либо, за доверенным общим входом, IP посетителя от него.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Исходный клиент — демонстрация, встраиваемая только этим же сайтом.
	handle /client/* {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'"
			X-Frame-Options SAMEORIGIN
			Cache-Control no-cache
			defer
		}
		root * /srv
		file_server
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
