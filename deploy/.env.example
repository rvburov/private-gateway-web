# Настройки рабочего сервера (deploy/README.md). Файл deploy/.env лежит только на сервере
# (chmod 600) и в git не попадает. server-setup.sh создает его сам: случайные пароль базы
# и ключи, настройки бэкапа — из deploy/.env AI Agent Capper (тот же ключ age и бакет).

# docker compose из папки deploy берет рабочий файл, а не локальный compose.yml
COMPOSE_FILE=compose.prod.yml
COMPOSE_PROJECT_NAME=private-gateway-web

# Домен сайта: DNS-запись A на IP сервера AI Agent Capper (server-setup.sh --domain)
PGWEB_DOMAIN=gateway.example.com

# Пароль базы и ключи: 24 и 32 случайных байта в hex. PGWEB_MASTER_KEYS сохранить в менеджер
# паролей: без него копия базы не расшифрует 2FA участников
POSTGRES_PASSWORD=
PGWEB_SECRET_KEY=
PGWEB_MASTER_KEYS=

# Лимиты: одновременные входы на сайт (новый вход сверх лимита завершает самый давний) и
# устройства с приложением на участника (у участника можно задать свой лимит в карточке)
# PGWEB_SESSION_LIMIT=3
# PGWEB_DEVICE_LIMIT=3
# PGWEB_APP_TOKEN_DAYS=30

# Общий вход (Caddy AI Agent Capper): папка файлов сайтов и подсети. Значения по умолчанию
# совпадают с настройками capper, подсеть caddy-ingress deploy.sh берет из docker сам
# PGWEB_CADDY_SITES_DIR=/opt/ai_agent_capper/deploy/caddy-sites
# PGWEB_INGRESS_SUBNET=10.204.0.0/24
# PGWEB_EDGE_SUBNET=172.31.247.0/28

# Бэкапы: публичные ключи age (владельца и сервера) и секретный ключ сервера для проверки
# восстановления. S3 — тот же бакет, что у capper, своя папка BACKUP_S3_PREFIX
BACKUP_AGE_RECIPIENTS=
BACKUP_AGE_IDENTITY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=private-gateway-web
# BACKUP_LOCAL_DIR=./backups
# PGWEB_IMPORTS_DIR=./imports
