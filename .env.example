# Шаблон для разработки. scripts/dev.sh init создает .env.local со случайными ключами.
# Этот файл не содержит рабочих значений секретов и сам по себе не запускает приложение.
POSTGRES_PASSWORD=
PGWEB_SECRET_KEY=
# Формат: версия:64 шестнадцатеричных символа; отдельный ключ для шифрования TOTP.
PGWEB_MASTER_KEYS=
PGWEB_DATABASE_URL=postgresql+asyncpg://pgweb:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/pgweb
PGWEB_PUBLIC_ORIGIN=http://127.0.0.1:5173
PGWEB_COOKIE_SECURE=false
PGWEB_DOWNLOAD_ROOT=../.localdata/downloads
